# Variables que consume docker compose.
#
# **No hace falta rellenarlo a mano entero.** Desde la raíz del repo:
#   ./scripts/init-env.sh
# crea este archivo, genera los cuatro secretos que nadie necesita leer nunca, y
# te dice cuáles faltan. Es idempotente: no pisa un valor que ya esté puesto.
#
# El .env de server/ es solo para desarrollo local sin Docker; en el despliegue
# manda este.

# ---------- Elige UN camino ----------
# El proxy va en una override de compose, y hay dos opciones excluyentes.
# Descomenta la que uses; con esto el comando sigue siendo `docker compose up -d`.

# (A) Túnel de ngrok. Sin dominio, sin certificado, sin abrir puertos. Es el
#     camino rápido para probar y para demos. El servidor detecta la URL del
#     túnel solo y la escribe en su log al arrancar.
COMPOSE_FILE=docker-compose.yml:docker-compose.ngrok.yml

# (B) Dominio propio con TLS automático. Es el camino definitivo.
#COMPOSE_FILE=docker-compose.yml:docker-compose.caddy.yml

# ---------- (A) ngrok ----------
# De https://dashboard.ngrok.com/get-started/your-authtoken (cuenta gratuita).
# Solo hace falta con el camino (A).
NGROK_AUTHTOKEN=changeme_con_tu_authtoken_de_ngrok

# ---------- (B) Dominio y certificado ----------
# Solo hacen falta con el camino (B). Con (A) se dejan vacíos o comentados.
# El dominio tiene que resolver YA a la IP de la instancia antes de levantar:
# Let's Encrypt valida por el puerto 80 y falla si no llega.
#DOMAIN=drivesidian.ejemplo.com
# Correo al que Let's Encrypt avisa si un certificado va a caducar.
#ACME_EMAIL=tu-correo@ejemplo.com
# URL pública con la que el agente abre la página de vinculación. Con (B) se
# pone a mano; con (A) se deja vacía y la detecta del túnel.
#PUBLIC_URL=https://drivesidian.ejemplo.com

# ---------- Base de datos ----------
# Postgres corre en un contenedor de esta misma instancia, sin puerto expuesto
# hacia afuera, así que esta contraseña no sale de la red de compose. La genera
# init-env.sh; a mano sería:
#   openssl rand -hex 32
POSTGRES_PASSWORD=changeme

# ---------- Secretos de la aplicación ----------
# Los tres los genera init-env.sh. A mano, los tres igual:
#   openssl rand -hex 32
#
# **Tienen que ser hex de 64 caracteres**, no base64: TOTP_ENCRYPTION_KEY se lee
# con Buffer.from(valor, 'hex') para AES-256-GCM (utils/secretCrypto.js). Con
# otro formato el servidor arranca igual y falla al enrolar el primer 2FA, que
# es mucho peor que fallar de entrada.

# Firma los JWT propios: sesión web y agent tokens.
JWT_SECRET=changeme_con_un_secreto_generado_de_32_bytes

# Cifra totp_secret en reposo (AES-256-GCM). Si se pierde, NADIE puede volver a
# validar un código de 2FA: todas las cuentas tendrían que reenrolarse.
TOTP_ENCRYPTION_KEY=changeme_con_un_secreto_generado_de_32_bytes

# Deriva el topic de ntfy de cada usuario por HMAC sobre su id. Cambiarlo
# cambia el topic de TODOS a la vez y obliga a volver a suscribirse.
NTFY_SECRET=changeme_con_un_secreto_generado_de_32_bytes

# ---------- GitHub ----------
# Personal Access Token con permiso de escritura sobre el repo compartido.
# El repo debe ser PRIVADO: contiene las notas de todos los usuarios.
GITHUB_TOKEN=changeme_con_un_personal_access_token
GITHUB_OWNER=changeme
GITHUB_REPO=changeme
GITHUB_BRANCH=main

# ---------- Ajustes opcionales ----------
# Cada cuánto corre el worker de sincronización (ms). 300000 = 5 minutos.
SYNC_INTERVAL_MS=300000
# Días que se conservan los eventos en security_events antes de podarlos.
SECURITY_EVENT_RETENTION_DAYS=90
