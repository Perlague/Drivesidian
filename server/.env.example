# Puerto en el que escucha el servidor Express.
PORT=3000

# Cadena de conexión a Postgres. node-pg-migrate y la app la leen de aquí.
DATABASE_URL=postgres://drivesidian:drivesidian@localhost:5432/drivesidian

# Usados únicamente por seeders/seed.js para crear la cuenta de desarrollo.
SEED_ADMIN_EMAIL=admin@drivesidian.local
SEED_ADMIN_PASSWORD=changeme123

# Firma los JWT propios (sesión web + agent tokens). Generar uno propio con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=changeme_con_un_secreto_generado_de_32_bytes

# Cifra totp_secret en reposo (AES-256-GCM). Generar igual que JWT_SECRET.
TOTP_ENCRYPTION_KEY=changeme_con_un_secreto_generado_de_32_bytes

# Personal Access Token de GitHub con permiso de escritura sobre el repo
# compartido, usado por el worker de sincronización.
GITHUB_TOKEN=changeme_con_un_personal_access_token
GITHUB_OWNER=changeme
GITHUB_REPO=changeme

# Topic de ntfy.sh (https://ntfy.sh/TOPIC) para la notificación de sync.
NTFY_TOPIC=changeme
