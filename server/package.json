{
  "name": "drivesidian-server",
  "version": "0.1.0",
  "private": true,
  "description": "API de Drivesidian: autenticación, notas y sincronización con GitHub.",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "migrate": "node-pg-migrate",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "migrate:create": "node-pg-migrate create",
    "seed": "node seeders/seed.js"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.20.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "node-pg-migrate": "^8.0.4"
  }
}
