# Normalización de finales de línea.
* text=auto

# Estos archivos los ejecuta Linux dentro del contenedor. Si git los entrega con
# CRLF al clonar en Windows, el shebang deja de funcionar y el contenedor muere
# con un "no such file or directory" que no dice nada del problema real.
*.sh text eol=lf
Dockerfile text eol=lf
docker-compose.yml text eol=lf
Caddyfile text eol=lf

# cmd.exe y wscript EXIGEN CRLF. Con LF, cmd se come el primer carácter de cada
# línea y el script falla con errores que no apuntan al problema real.
*.cmd text eol=crlf
*.bat text eol=crlf
*.vbs text eol=crlf
