<%- include('partials/head', { title, extraCss: '/css/editor.css', datos: { nota: noteId } }) %>
<%- include('partials/nav', { current: 'notes' }) %>

<main class="editor-main">
  <div class="editor-cabecera">
    <div>
      <h1 id="ruta" class="mono">Cargando…</h1>
      <p class="subtitulo" id="meta"></p>
    </div>
    <div class="acciones sin-margen">
      <button type="button" id="btn-guardar" disabled>Guardar</button>
      <a href="/notes"><button type="button" class="secundario">Volver</button></a>
    </div>
  </div>

  <div class="aviso" id="aviso"></div>

  <!-- Resolución de conflicto. Reemplaza al editor cuando la nota tiene una
       decisión pendiente: editar encima crearía un tercer estado. -->
  <section id="panel-conflicto" hidden>
    <div class="aviso atencion">
      <strong>Esta nota cambió en los dos lados.</strong>
      Tu equipo y el servidor tienen versiones distintas, y nadie las ha pisado.
      Elige con cuál quedarte.
    </div>

    <div class="comparacion">
      <div>
        <h3>La de tu computadora</h3>
        <pre class="mono" id="conflicto-local"></pre>
      </div>
      <div>
        <h3>La del servidor</h3>
        <pre class="mono" id="conflicto-servidor"></pre>
      </div>
    </div>

    <div class="acciones">
      <button type="button" id="btn-quedarme-local">Mantener la de mi computadora</button>
      <button type="button" class="secundario" id="btn-quedarme-servidor">Mantener la del servidor</button>
    </div>
    <p class="pista">
      La que descartes se pierde. Si quieres quedarte con partes de las dos,
      cópialas antes de elegir.
    </p>
  </section>

  <div class="editor-layout" id="editor-layout">
    <textarea id="markdown-input" spellcheck="false"
              placeholder="Escribe tu nota en markdown…" disabled></textarea>
    <div id="preview" class="preview"></div>
  </div>
</main>

<!-- Diálogo de conflicto: aparece cuando el agente subió una versión más nueva
     mientras la nota estaba abierta aquí. -->
<dialog id="dialogo-conflicto">
  <h2>Esta nota cambió mientras la editabas</h2>
  <p class="pista">
    El agente subió una versión más nueva desde tu equipo. Elige con cuál
    quedarte; no se fusionan solas porque juntar dos ediciones de prosa no
    produce un texto coherente.
  </p>

  <div class="comparacion" id="comparacion" hidden>
    <div>
      <h3>La tuya (en esta pestaña)</h3>
      <pre class="mono" id="version-mia"></pre>
    </div>
    <div>
      <h3>La del servidor</h3>
      <pre class="mono" id="version-servidor"></pre>
    </div>
  </div>

  <div class="acciones">
    <button type="button" id="btn-quedarme-mia">Mantener la mía</button>
    <button type="button" class="secundario" id="btn-quedarme-servidor">Mantener la del servidor</button>
    <button type="button" class="secundario" id="btn-ver-ambas">Ver ambas</button>
    <button type="button" class="enlace" id="btn-cerrar-conflicto">Cancelar</button>
  </div>
</dialog>

<!-- Servidos desde este mismo servidor, no desde un CDN: es lo que permite
     que la CSP del Caddyfile no tenga que autorizar ningún origen externo.
     Se actualizan a mano; el procedimiento está en docs/DESPLIEGUE.md. -->
<script src="/vendor/marked.min.js"></script>
<script src="/vendor/purify.min.js"></script>
<%- include('partials/foot', { pageScript: '/js/editor.js' }) %>
