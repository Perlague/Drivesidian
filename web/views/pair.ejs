<%- include('partials/head', { title, datos: { codigo: code || '' } }) %>
<%- include('partials/nav', { current: '' }) %>

<main class="angosto">
  <h1>Vincular equipo</h1>
  <p class="subtitulo">Un agente de Drivesidian pide permiso para sincronizar tus notas.</p>

  <div class="tarjeta">
    <div class="aviso" id="aviso"></div>
    <p class="cargando" id="cargando">Consultando el código…</p>

    <div id="detalle" hidden>
      <table>
        <tbody>
          <tr><th>Equipo</th><td id="equipo" class="mono"></td></tr>
          <tr><th>Código</th><td id="codigo" class="mono"></td></tr>
          <tr><th>Caduca</th><td id="caduca"></td></tr>
        </tbody>
      </table>

      <div class="campo margen-arriba-amplio" id="campo-vault" hidden>
        <label for="vault">¿Qué vault de Obsidian debe vigilar?</label>
        <select id="vault"></select>
        <p class="pista">El agente encontró más de uno en ese equipo.</p>
      </div>

      <p class="pista" id="vault-unico" hidden></p>

      <div class="acciones">
        <button type="button" id="btn-aprobar">Vincular este equipo</button>
        <a href="/notes"><button type="button" class="secundario">Cancelar</button></a>
      </div>
    </div>

    <div id="listo" hidden>
      <p class="aviso exito">
        Equipo vinculado. El agente recogerá su acceso en unos segundos y
        empezará a sincronizar tus notas.
      </p>
      <a href="/dashboard"><button type="button">Ir a la configuración</button></a>
    </div>
  </div>
</main>

<%- include('partials/foot', { pageScript: '/js/pair.js' }) %>
