<%- include('partials/head', { title }) %>

<main class="angosto">
  <h1>Entrar</h1>
  <p class="subtitulo">Drivesidian sincroniza tus notas de Obsidian con GitHub.</p>

  <div class="tarjeta">
    <div class="aviso" id="aviso"></div>

    <form id="form-login" novalidate>
      <div class="campo">
        <label for="email">Correo</label>
        <input type="email" id="email" name="email" autocomplete="username" required />
      </div>

      <div class="campo">
        <label for="password">Contraseña</label>
        <input type="password" id="password" name="password" autocomplete="current-password" required />
      </div>

      <!-- Se revela solo si la cuenta tiene 2FA: el servidor responde 400
           pidiendo el código en el primer intento. -->
      <div class="campo" id="campo-totp" hidden>
        <label for="totp">Código de tu app de autenticación</label>
        <input type="text" id="totp" name="totp" inputmode="numeric" autocomplete="one-time-code"
               pattern="[0-9]{6}" maxlength="6" placeholder="000000" />
      </div>

      <button type="submit" class="ancho" id="btn-entrar">Entrar</button>
    </form>

    <p class="pista" style="margin-top: 1rem;">
      ¿No tienes cuenta? <a href="/register<%= next ? '?next=' + encodeURIComponent(next) : '' %>">Crear una</a>
    </p>
  </div>
</main>

<script>window.SIGUIENTE = <%- JSON.stringify(next || '') %>;</script>
<%- include('partials/foot', { pageScript: '/js/login.js' }) %>
